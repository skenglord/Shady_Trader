{
  "$schema": "https://www.freqtrade.io/schema/config-v3.json",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "dry_run": true,
  "dry_run_wallet": 1000,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 30
  },
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "exchange": {
    "name": "${FREQTRADE__EXCHANGE__NAME}",
    "key": "${FREQTRADE__EXCHANGE__KEY}",
    "secret": "${FREQTRADE__EXCHANGE__SECRET}",
    "password": "${FREQTRADE__EXCHANGE__PASSWORD}",
    "ccxt_config": {},
    "ccxt_sync_config": {
      "options": {
        "defaultType": "future"
      }
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "timeframe": "1h",
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8081,
    "verbosity": "info",
    "enable_openapi": false,
    "jwt_secret_key": "${FREQTRADE__API_SERVER__JWT_SECRET_KEY}",
    "username": "${FREQTRADE__API_SERVER__USERNAME}",
    "password": "${FREQTRADE__API_SERVER__PASSWORD}"
  },
  "bot_name": "shady_trader_freqtrade",
  "initial_state": "stopped",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}