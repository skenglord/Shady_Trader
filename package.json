{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "DISABLE_HMR=true tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=json-summary npm test",
    "quality:coverage": "npm run test:coverage && node scripts/check-coverage.mjs",
    "quality:complexity": "node scripts/check-complexity.mjs",
    "quality:ci": "npm run lint && npm run test && npm run quality:coverage && npm run quality:complexity && npm run security:audit",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "audit:archive": "tsx scripts/archive-audit-logs.ts",
    "bot:launch": "node scripts/launch-bot.mjs",
    "trading-cli": "tsx cli/src/index.ts",
    "cli:status": "tsx cli/src/index.ts engine status",
    "cli:monitor": "tsx cli/src/index.ts monitor",
    "cli:backtest": "tsx cli/src/index.ts backtest",
    "backtest": "tsx backend/scripts/backtest.ts",
    "docker:build": "docker build -t shady-trader .",
    "docker:run": "docker run -p 3000:3000 shady-trader",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "k8s:deploy": "kubectl apply -f k8s/",
    "k8s:undeploy": "kubectl delete -f k8s/",
    "migrate:postgres": "tsx scripts/migrate-to-postgres.ts",
    "migrate:slippage": "tsx scripts/migrate-slippage-schema.ts",
    "ml:ingest": "tsx scripts/bulk_ingest_candles.ts",
    "ml:train": "tsx scripts/train_models.ts",
    "ml:status": "tsx -e \"import('./backend/ml/index').then(m => m.getMLHealth().then(console.log))\"",
    "ml:check-py": "python3 -c \"import xgboost, sklearn, shap, joblib, scipy; print('Python ML deps OK')\"",
    "ml:setup": "npm run ml:check-py && npm run ml:ingest && npm run ml:train",
    "freqtrade:install": "bash backend/freqtrade/scripts/install_freqtrade.sh",
    "freqtrade:up": "bash backend/freqtrade/start_server.sh",
    "freqtrade:down": "bash backend/freqtrade/stop_server.sh",
    "freqtrade:smoke": "backend/freqtrade/venv/bin/python backend/freqtrade/scripts/smoke_test.py",
    "freqtrade:ingest": "backend/freqtrade/venv/bin/python backend/freqtrade/scripts/bulk_ingest_candles.py",
    "freqtrade:upgrade": "pip install --upgrade -r backend/freqtrade/requirements.txt",
    "freqtrade:cli": "tsx cli/src/index.ts freqtrade"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-jaeger": "^2.7.1",
    "@opentelemetry/exporter-otlp-grpc": "^0.26.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "axios": "^1.16.0",
    "better-sqlite3": "^12.9.0",
    "bullmq": "^5.76.6",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.0",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.546.0",
    "ml-regression": "^6.3.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "numjs": "^0.16.1",
    "openai": "^6.37.0",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "protobufjs": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-toastify": "^11.1.0",
    "recharts": "^3.8.1",
    "redis": "^5.12.1",
    "technicalindicators": "^3.1.0",
    "ws": "^8.19.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "blessed": "0.1.81",
    "blessed-contrib": "4.11.0",
    "boxen": "7.1.1",
    "c8": "^10.1.3",
    "chalk": "5.3.0",
    "cli-table3": "0.6.5",
    "commander": "12.1.0",
    "date-fns": "3.6.0",
    "inquirer": "10.2.2",
    "ora": "8.1.1",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.6"
  }
}
