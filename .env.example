# ─────────────────────────────────────────────────────────────────
# Shady Trader — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Generate strong secrets with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────

# ── Application ──
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DB_PATH=trading.db
LOG_LEVEL=info
LOG_DIR=./logs
CORS_ORIGIN=http://localhost:3000
APP_URL=
DISABLE_HMR=false
BOT_URL=http://localhost:3000

# ── AUTHENTICATION (REQUIRED) ──
# API auth tokens. Without these, all API requests return 503.
# Use DIFFERENT tokens for admin (full control) and trader (view + moderate ops).
API_ADMIN_TOKEN=replace-me-with-64-char-random-hex
API_TRADER_TOKEN=replace-me-with-different-64-char-random-hex
API_AUTH_TOKEN=

# ── SESSION SECURITY ──
# Session signing secret. If not set, a random ephemeral one is generated
# on startup (sessions invalidated on restart). SET THIS in production.
SESSION_SECRET=replace-me-with-64-char-random-hex

# ── EXCHANGE API KEYS (optional, for live trading) ──
# Leave empty for paper/sandbox trading only.
# EXCHANGE_NAME selects the primary data/execution provider.
EXCHANGE_NAME=coingecko
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=
EXCHANGE_USE_TESTNET=true

# Provider-specific API keys (used when EXCHANGE_NAME matches or as fallback)
COINGECKO_API_KEY=
COINAPI_API_KEY=
CRYPTOCOMPARE_API_KEY=

# Live exchange keys (only needed for EXCHANGE_NAME=binance/kraken/okx/coinbase)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=

# ── DATABASE ──
# SQLite is the default. Set USE_POSTGRES=true for PostgreSQL.
USE_POSTGRES=false

# PostgreSQL (production)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shady_trader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_MAX_CONNECTIONS=20

# ── REDIS ──
# Optional. Without Redis, job queues are disabled and state falls back to in-memory.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── AI / ML ──
GEMINI_API_KEY=

# Ollama (local LLM for signal confirmation)
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4

# Gemma signal confirmation
GEMMA_ENABLED=true
GEMMA_TIMEOUT_MS=2000
GEMMA_MIN_CONF_SCORE=70

# ML Pipeline (disabled by default; requires Python 3.11+ with scikit-learn/xgboost)
ML_ENABLED=false
ML_PYTHON_BIN=python3
ML_MODELS_DIR=./models
ML_MIN_TRAINING_ROWS=10000
ML_CONFIDENCE_THRESHOLD=0.58
ML_ENTRY_FILTER_THRESHOLD=0.55
ML_EXIT_CHECKPOINTS=0.05,0.12,0.20,0.35,0.50,0.80
ML_EXIT_CLOSE_ON_GREEN_AT=0.20
ML_EXIT_FORCE_CLOSE_AT=0.92

# ── FREQTRADE SIDECAR (optional) ──
# Leave disabled for in-house trading/backtesting only.
FREQTRADE_ENABLED=false
FREQTRADE_LISTEN_PORT=8081
FREQTRADE_QUEUE_CONCURRENCY=1
FREQTRADE_DEFAULT_PAIRS=BTC/USDT,ETH/USDT
FREQTRADE_TRADING_MODE=spot
FREQTRADE_VALIDATE_TOLERANCE=0.05

# Freqtrade webserver auth (required when FREQTRADE_ENABLED=true)
FREQTRADE_API_USER=change-me-freqtrade-api-user
FREQTRADE_API_PASS=change-me-freqtrade-api-password

# Freqtrade nested config (exchange overrides for Freqtrade's own config.json)
FREQTRADE__EXCHANGE__NAME=binance
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=
FREQTRADE__EXCHANGE__PASSWORD=

# Freqtrade API server config
FREQTRADE__API_SERVER__JWT_SECRET_KEY=replace-with-64-char-random-string
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE_JWT_SECRET_KEY=

# ── REGIME DETECTION ──
ATR_PERCENTILE_LOOKBACK=8064
ATR_PERCENTILE_BOOTSTRAP_MIN=288
REGIME_STABILITY_GATING=false

# ── RISK MANAGEMENT ──
DEGEN_LIVE_OVERRIDE=false
MAX_EFFECTIVE_RISK_FRACTION=0.005
DEGEN_MAX_RISK_DOLLARS=500
RISK_MODE_DEFAULT=conservative

# ── SLIPPAGE / TRANSACTION COSTS ──
TAKER_FEE_RATE=0.0006
MAKER_FEE_RATE=0.0001
SLIPPAGE_SKIP_THRESHOLD=0.45
FIXED_SLIPPAGE_FALLBACK=0.0005
SLIPPAGE_BASE_FRAC=0.0005

# ── EXECUTION LOCK ──
TRADE_LOCK_TTL_MS=8000

# ── ATR RATCHET ──
RATCHET_CALIBRATED=false

# ── OBSERVABILITY ──
OTLP_ENDPOINT=http://localhost:4317

# ── FRONTEND (Vite build-time injection) ──
# Falls back to API_ADMIN_TOKEN / API_TRADER_TOKEN if not set.
VITE_ADMIN_TOKEN=
VITE_TRADER_TOKEN=
VITE_API_BASE_URL=
VITE_WS_URL=
