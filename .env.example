# Database Configuration
USE_POSTGRES=false

# PostgreSQL Configuration (when USE_POSTGRES=true)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shady_trader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_MAX_CONNECTIONS=20

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Exchange API Keys (for production use secure storage)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=
COINBASE_API_KEY=
COINBASE_SECRET_KEY=
OKX_API_KEY=
OKX_SECRET_KEY=

# ════════════════════════════════════════════════════════════
# v6.0 UPGRADE VARIABLES
# ════════════════════════════════════════════════════════════

# ── Phase 1: Regime Detection v2 ──
ATR_PERCENTILE_LOOKBACK=8064         # candles for vol regime (4 weeks at 5m)
ATR_PERCENTILE_BOOTSTRAP_MIN=288     # minimum before percentile is trusted (1 day)
REGIME_STABILITY_GATING=false        # gate signals on low regime stability

# ── Phase 1: Risk Safety ──
DEGEN_LIVE_OVERRIDE=false            # MUST be true to run degen in live trading
MAX_EFFECTIVE_RISK_FRACTION=0.005    # 0.5% max effective risk per trade
DEGEN_MAX_RISK_DOLLARS=500           # absolute dollar cap for degen positions
RISK_MODE_DEFAULT=conservative

# ── Phase 1: Slippage (ALL FRACTIONS — not percentages) ──
TAKER_FEE_RATE=0.0006                # 0.06%
MAKER_FEE_RATE=0.0001                # 0.01%
SLIPPAGE_SKIP_THRESHOLD=0.45         # skip if slippage > 45% of TP distance
FIXED_SLIPPAGE_FALLBACK=0.0005       # 0.05% fallback

# ── Phase 1: Execution Locking ──
TRADE_LOCK_TTL_MS=8000               # Redis lock TTL (ms) — increase for slow exchanges

# ── Phase 2: ATR Ratchet ──
RATCHET_CALIBRATED=false             # set true after running --calibrate-ratchet

# ── Phase 2: Gemma AI ──
GEMMA_ENABLED=true
GEMMA_TIMEOUT_MS=2000                # hard abort timeout
GEMMA_MIN_CONF_SCORE=70              # min rule score to invoke Gemma
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# ── Phase 2/3: ML ──
ML_ENTRY_FILTER_THRESHOLD=0.55       # entry filter probability threshold