# Development Environment Configuration
NODE_ENV=development
USE_POSTGRES=false

# Database (SQLite for development)
# USE_POSTGRES=true for PostgreSQL

# API Keys (use .env file for actual values)
GEMINI_API_KEY=your_dev_gemini_api_key
BINANCE_API_KEY=your_dev_binance_api_key
BINANCE_SECRET_KEY=your_dev_binance_secret_key
KRAKEN_API_KEY=your_dev_kraken_api_key
KRAKEN_PRIVATE_KEY=your_dev_kraken_private_key

# Logging
LOG_LEVEL=debug

# Server
PORT=3000
HOST=localhost