# Production Environment Configuration
NODE_ENV=production
USE_POSTGRES=true

# Database
POSTGRES_HOST=shady-trader-postgres
POSTGRES_PORT=5432
POSTGRES_DB=shady_trader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_production_password
POSTGRES_MAX_CONNECTIONS=20

# API Keys (managed via Kubernetes secrets)
# GEMINI_API_KEY=...
# BINANCE_API_KEY=...
# BINANCE_SECRET_KEY=...
# KRAKEN_API_KEY=...
# KRAKEN_PRIVATE_KEY=...

# Logging
LOG_LEVEL=warn

# Server
PORT=3000
HOST=0.0.0.0

# Monitoring
PROMETHEUS_ENABLED=true

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=https://yourdomain.com